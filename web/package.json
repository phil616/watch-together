{
  "name": "movie-sync-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "e2e": "npm run build && playwright test",
    "test:player": "playwright test --config playwright.player.config.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/modals": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@vitejs/plugin-react": "latest",
    "artplayer": "5.4.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^29.0.0",
    "prettier": "^3.3.3",
    "vitest": "latest"
  }
}
