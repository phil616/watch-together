APP_ENV=production
APP_BASE_URL=http://watch.example.com
HTTP_LISTEN_ADDR=127.0.0.1:8080
DATA_DIR=/var/lib/watchtogether
DATABASE_PATH=/var/lib/watchtogether/application.db
SESSION_TTL=720h
ROOM_MAX_MEMBERS=20
HOST_RECONNECT_GRACE_MS=30000
MAX_MEDIA_SIZE_BYTES=21474836480
S3_ENDPOINT=
# 可选：浏览器可访问的 endpoint；与后端内部地址不同时设置
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
S3_UPLOAD_URL_TTL=1h
S3_MEDIA_URL_TTL=6h
ALLOWED_ORIGINS=http://watch.example.com
LOG_LEVEL=info
