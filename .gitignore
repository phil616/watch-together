# Local environment and secrets
/.env
/.env.*
!/.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime state and user-uploaded media
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Go build and test output
/watchtogether
/watchtogether.exe
/bin/
/coverage/
*.test
*.out
coverage.txt
coverage.html

# Frontend dependencies, generated output, and caches
/web/node_modules/
/web/dist/
/web/coverage/
/web/playwright-report/
/web/test-results/
*.tsbuildinfo
/web/vite.config.js
/web/vite.config.d.ts

# The SPA is generated by `npm run build` before the Go binary is built.
# Keep only a tiny source-controlled file so //go:embed also works in a clean
# checkout before the first frontend build.
/internal/webui/dist/*
!/internal/webui/dist/embed-placeholder.txt

# Local tools and editor state
/.codegraph/*.db
/.codegraph/*.db-shm
/.codegraph/*.db-wal
/.idea/
/.vscode/
*.swp
*.swo
*~

# Logs, temporary files, and OS metadata
*.log
*.tmp
*.temp
/.cache/
/.tmp/
/tmp/
.DS_Store
Thumbs.db

# Local release artifacts
/release/
/artifacts/
*.exe
*.dll
*.so
*.dylib
